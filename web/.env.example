# API Base URL (defaults to /apps/solilo/api, proxied to localhost:8787 in dev)
VITE_API_BASE_URL=/apps/solilo/api

# Public origin shown in generated <solilo-timeline> website embed snippets
# Production example: https://kate0115.cc
VITE_PUBLIC_ORIGIN=https://kate0115.cc

# Firebase Web App Configuration (Project Settings -> General -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: set to http://localhost:9099 if using Firebase Auth Local Emulator
VITE_FIREBASE_AUTH_EMULATOR_URL=
