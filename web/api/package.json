{
  "name": "@solilo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Solilo backend API (Hono + Zod OpenAPI + Firebase Admin)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
